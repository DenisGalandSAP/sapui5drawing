<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <VBox
        fitContainer="true"
        class="drawingShell"
    >
        <OverflowToolbar>
            <Title text="{i18n>toolsTitle}" />
            <SegmentedButton
                id="toolSelector"
                selectedKey="pen"
                selectionChange=".onToolChange"
            >
                <items>
                    <SegmentedButtonItem
                        key="pen"
                        text="{i18n>toolPen}"
                    />
                    <SegmentedButtonItem
                        key="line"
                        text="{i18n>toolLine}"
                    />
                    <SegmentedButtonItem
                        key="rect"
                        text="{i18n>toolRect}"
                    />
                    <SegmentedButtonItem
                        key="circle"
                        text="{i18n>toolCircle}"
                    />
                    <SegmentedButtonItem
                        key="select"
                        text="{i18n>toolSelect}"
                    />
                    <SegmentedButtonItem
                        key="pan"
                        text="{i18n>toolPan}"
                    />
                </items>
            </SegmentedButton>
            <ToolbarSeparator />
            <Label text="{i18n>objectsLabel}" />
            <Select
                id="presetSelect"
                width="11rem"
                selectedKey="house"
            >
                <items>
                    <core:Item
                        key="house"
                        text="{i18n>presetHouse}"
                    />
                    <core:Item
                        key="car"
                        text="{i18n>presetCar}"
                    />
                    <core:Item
                        key="tree"
                        text="{i18n>presetTree}"
                    />
                    <core:Item
                        key="sun"
                        text="{i18n>presetSun}"
                    />
                    <core:Item
                        key="boat"
                        text="{i18n>presetBoat}"
                    />
                    <core:Item
                        key="cloud"
                        text="{i18n>presetCloud}"
                    />
                </items>
            </Select>
            <Button
                text="{i18n>insertObject}"
                press=".onInsertPresetButtonPress"
            />
            <ToolbarSeparator />
            <Label text="{i18n>zoomLabel}" />
            <Slider
                id="zoomSlider"
                width="11rem"
                min="0.25"
                max="4"
                step="0.05"
                value="1"
                liveChange=".onZoomSliderChange"
            />
            <Button
                text="{i18n>resetView}"
                press=".onResetView"
            />
            <Button
                text="{i18n>undo}"
                press=".onUndo"
            />
            <Button
                text="{i18n>decreaseSize}"
                press=".onSmallerButtonPress"
            />
            <Button
                text="{i18n>increaseSize}"
                press=".onLargerButtonPress"
            />
            <Button
                text="{i18n>clear}"
                type="Reject"
                press=".onClear"
            />
            <Button
                text="{i18n>downloadJpg}"
                type="Emphasized"
                press=".onDownloadJpg"
            />
        </OverflowToolbar>
        <core:HTML
            id="drawingHost"
            content="&lt;div class='db-root'&gt;&lt;canvas class='db-canvas'&gt;&lt;/canvas&gt;&lt;/div&gt;"
        />
    </VBox>
</core:FragmentDefinition>

<mvc:View
    controllerName="zab.be.resa.zuilibrdraw.controller.Main"
    displayBlock="true"
    height="100%"
    xmlns="sap.uxap"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:m="sap.m"
    xmlns:core="sap.ui.core"
>
    <ObjectPageLayout
        id="objectPageLayout"
        showTitleInHeaderContent="true"
        upperCaseAnchorBar="false"
    >
        <headerTitle>
            <ObjectPageHeader objectTitle="{i18n>appTitle}" />
        </headerTitle>
        <sections>
            <ObjectPageSection
                titleUppercase="false"
                title="{i18n>drawingSectionTitle}"
            >
                <subSections>
                    <ObjectPageSubSection>
                        <blocks>
                            <core:ComponentContainer
                                name="zab.be.resa.zuilibrdraw"
                                manifest="true"
                                async="true"
                                width="100%"
                                height="70vh"
                                lifecycle="Container"
                            />
                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
        </sections>
    </ObjectPageLayout>
</mvc:View>

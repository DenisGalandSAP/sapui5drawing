<mvc:View
    controllerName="zab.be.resa.zuidrawapp.controller.Main"
    displayBlock="true"
    height="100%"
    xmlns="sap.uxap"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:draw="zab.be.resa.draw"
>
    <ObjectPageLayout
        id="objectPageLayout"
        showTitleInHeaderContent="true"
        upperCaseAnchorBar="false"
    >
        <headerTitle>
            <ObjectPageHeader objectTitle="{i18n>appTitle}" />
        </headerTitle>
        <sections>
            <ObjectPageSection
                titleUppercase="false"
                title="{i18n>drawingSectionTitle}"
            >
                <subSections>
                    <ObjectPageSubSection>
                        <blocks>
                            <draw:DrawingBoard
                                editable="true"
                                width="100%"
                                height="70vh"
                                otype="CROQ"
                                objid="{context>/objid}"
                            />
                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
        </sections>
    </ObjectPageLayout>
</mvc:View>

{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "node",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "allowJs": false,
    "strict": true,
    "strictNullChecks": false,
    "noImplicitAny": true,
    "rootDir": "src",
    "baseUrl": "./",
    "paths": {
      "zab/be/resa/draw/*": [
        "./src/zab/be/resa/draw/*"
      ]
    },
    "typeRoots": [
      "../node_modules/@types",
      "../node_modules/@sapui5"
    ],
    "types": [
      "types"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
